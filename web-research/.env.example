# Research portal — Supabase configuration.
# Copy to `.env` (or `.env.local`) and fill in your project's values.
# The PUBLISHABLE key is safe to expose in the browser; RLS plus the research_*
# SECURITY DEFINER functions enforce all access.
# NEVER put the service_role / secret key here — it must never reach the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXX
